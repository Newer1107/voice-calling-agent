# ---------------------------------------------------------------------------
# Voice agent environment. Copy to agent/.env and fill in real values.
# Variable names are canonical per shared/configuration/env-conventions.md.
# LiveKit secrets stay server-side: the browser only ever receives a
# short-lived JWT from POST /token.
# ---------------------------------------------------------------------------

# --- LiveKit ----------------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WORKER_NAME=voice-agent

# --- Ollama LLM -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT_MS=30000
OLLAMA_MAX_RETRIES=2
OLLAMA_MAX_TOKENS=512
# Optional: override the default spoken-style system prompt (see src/voice_agent/clients/prompts.py)
#OLLAMA_SYSTEM_PROMPT=

# --- Faster-Whisper STT -----------------------------------------------------
STT_MODEL_SIZE=medium
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=          # blank = auto-detect (English + Hindi)


# --- VAD / endpointing ------------------------------------------------------
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700

# --- Kokoro TTS -------------------------------------------------------------
TTS_BASE_URL=http://localhost:8880
TTS_VOICE=af_heart
TTS_HINDI_VOICE=hi-IN-SwaraNeural
TTS_SPEED=1.0
TTS_TIMEOUT_MS=15000

# --- n8n webhook tools ------------------------------------------------------
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
N8N_WEBHOOK_TIMEOUT_MS=10000
N8N_WEBHOOK_MAX_RETRIES=1

# --- Agent HTTP helper API (token issuance, history, health) ----------------
AGENT_HOST=0.0.0.0
AGENT_PORT=8080
ENABLE_AGENT_API=true
# Beyond shared/configuration/env-conventions.md: comma-separated CORS origins for the
# helper API (the frontend dev server is not same-origin with the agent).
AGENT_CORS_ORIGINS=http://localhost:3000

# --- Logging & conversation -------------------------------------------------
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FORMAT=json
SESSION_HISTORY_LIMIT=50

# --- Dashboard (realtime business console) ----------------------------------
ENABLE_DASHBOARD=true
DASHBOARD_DATABASE_URL=postgresql://raunak@127.0.0.1:5432/voice_dashboard
