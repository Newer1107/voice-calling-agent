# LiveKit server configuration — self-hosted example.
# Copy to livekit.yaml and edit. For LiveKit Cloud you do not need this file
# at all — you only need LIVEKIT_URL / API key / secret from the dashboard.

port: 7880
bind_addresses:
  - ""

# Replace with your own key/secret pair. THIS IS DEV DEFAULT ONLY.
# The same key/secret must be set in agent/.env (LIVEKIT_API_KEY/SECRET).
keys:
  devkey: devsecret

rtc:
  # Public IP of this VPS. Required when LiveKit is behind NAT so it can
  # advertise the right ICE candidate to browsers.
  node_ip: 0.0.0.0
  # UDP port range used for media. Open these (or forward) on the firewall.
  udp_port: 7881
  tcp_port: 7881

# Optional — enable when a TURN server is configured; otherwise browsers
# behind strict NAT may fail to establish media. LiveKit Cloud handles TURN
# for you; self-hosted setups usually add coturn.
# turn:
#   enabled: false
