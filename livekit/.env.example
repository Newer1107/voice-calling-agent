# LiveKit connection values — copy to livekit/.env (VPS).
# These are the values consumed by frontend/ and agent/; keep them in sync.
# Self-hosted dev defaults shown; replace with your real values.

# WebSocket URL the BROWSER connects to (must be reachable over the internet).
LIVEKIT_URL=wss://livekit.example.com

# API key/secret used by the agent (Home Server) to sign join tokens.
# Never expose these to the browser.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
