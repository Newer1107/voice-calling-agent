# LiveKit Cloud connection values — copy to livekit/.env (reference only).
# These are consumed by frontend/ and agent/; keep them in sync.
# Get your project URL + API key/secret from the LiveKit Cloud dashboard.

# WebSocket URL the BROWSER connects to (public, from LiveKit Cloud).
LIVEKIT_URL=wss://<your-project>.livekit.cloud

# API key/secret used by the agent (Home Server) to sign join tokens.
# Never expose these to the browser.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
