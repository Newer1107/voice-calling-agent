# ---- LiveKit (browser connects directly; public) ----
# wss:// URL of the LiveKit server (same server the agent worker joins).
NEXT_PUBLIC_LIVEKIT_URL=wss://<your-project>.livekit.cloud

# ---- Agent FastAPI (token + history endpoints) ----
# Base URL of the agent's FastAPI helper, e.g. http://localhost:8080
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8080

# ---- Optional ----
# Display name for the agent participant in the transcript (default "Voice Agent").
NEXT_PUBLIC_AGENT_NAME=Voice Agent
