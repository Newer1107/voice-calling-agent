{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-agent.local/contracts/events.schema.json",
  "title": "Voice Agent Realtime Events",
  "description": "Messages exchanged over the LiveKit data channel between the Python agent and the browser. Agent -> browser messages are prefixed `agent.`/`state.`/`transcript.`; browser -> agent are prefixed `client.`. Both sides must ignore unknown message types for forward compatibility.",
  "type": "object",
  "required": ["type", "sessionId", "timestamp", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "agent.welcome",
        "agent.message.start",
        "agent.message.delta",
        "agent.message.done",
        "transcript.partial",
        "transcript.final",
        "tool.call",
        "tool.result",
        "tool.error",
        "state.connected",
        "state.listening",
        "state.speaking",
        "state.thinking",
        "error",
        "client.ptt.start",
        "client.ptt.stop",
        "client.config"
      ]
    },
    "sessionId": { "type": "string", "description": "Stable id for the conversation session" },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC" },
    "payload": {
      "type": "object",
      "description": "Type-specific payload, described per message type below."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "transcript.partial" } } },
      "then": {
        "properties": { "payload": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "transcript.final" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Optional Whisper confidence" },
              "language": { "type": "string", "description": "Optional detected language code" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.message.start" } } },
      "then": {
        "properties": { "payload": { "type": "object", "properties": { "messageId": { "type": "string" } } } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.message.delta" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["messageId", "text"],
            "properties": { "messageId": { "type": "string" }, "text": { "type": "string", "description": "Incremental text fragment" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.message.done" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["messageId", "text"],
            "properties": { "messageId": { "type": "string" }, "text": { "type": "string", "description": "Full final message" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.call" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["tool", "arguments"],
            "properties": {
              "tool": { "type": "string", "description": "Tool name, e.g. bookAppointment" },
              "arguments": { "type": "object", "description": "Arguments the LLM chose" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.result" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["tool", "ok", "summary"],
            "properties": {
              "tool": { "type": "string" },
              "ok": { "type": "boolean" },
              "summary": { "type": "string", "description": "Short human/machine readable result summary for the LLM" },
              "data": { "description": "Raw JSON returned by the webhook, when present" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.error" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["tool", "message"],
            "properties": { "tool": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "state.listening" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["active"],
            "properties": { "active": { "type": "boolean" }, "source": { "enum": ["vad", "ptt"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "state.speaking" } } },
      "then": {
        "properties": {
          "payload": { "type": "object", "required": ["active"], "properties": { "active": { "type": "boolean" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "state.thinking" } } },
      "then": {
        "properties": {
          "payload": { "type": "object", "required": ["active"], "properties": { "active": { "type": "boolean" } } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.welcome" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "sessionId": { "type": "string" },
              "conversationId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["stt_failed", "llm_failed", "tts_failed", "tool_failed", "internal", "session_expired"] },
              "message": { "type": "string" },
              "recoverable": { "type": "boolean", "default": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "client.ptt.start" } } },
      "then": {
        "properties": { "payload": { "type": "object", "maxProperties": 0 } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "client.ptt.stop" } } },
      "then": {
        "properties": { "payload": { "type": "object", "maxProperties": 0 } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "client.config" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "vadEnabled": { "type": "boolean" },
              "language": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
